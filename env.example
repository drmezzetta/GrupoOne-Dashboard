# ── Copiar este archivo a ".env" y completar los valores reales.
# ── ".env" NUNCA debe subirse a git (ya está en .gitignore).

# --- Servidor ---
PORT=3000
# Genera un valor random largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-por-un-valor-random-largo

# --- Login con Google (ver README, sección "Crear el proyecto de Google OAuth") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Dominio de correo corporativo permitido (deja vacío para permitir cualquier cuenta Google, no recomendado)
ALLOWED_EMAIL_DOMAIN=grupoone.com

# --- APIs de Integration Suite (ventas y stock comparten usuario/clave) ---
IS_BASIC_AUTH_USER=
IS_BASIC_AUTH_PASS=
VENTAS_API_URL=https://integration-suite-53jmw4yi.it-cpi034-rt.cfapps.us10-002.hana.ondemand.com/http/DEV/z_vtastiendas
STOCK_API_URL=https://integration-suite-53jmw4yi.it-cpi034-rt.cfapps.us10-002.hana.ondemand.com/http/PRD/grupo/z_stkreal_cons

# --- API de Rentabilidad (precio/costo) ---
# Hoy es la URL on-premise; cuando se publique en Integration Suite (mismo payload/response),
# reemplazar solo esta URL — el resto del código no cambia.
RENTABILIDAD_API_URL=https://vhrosws1wd01.sap.santarosa.com.uy:44380/sap/opu/odata/sap/zsb_prc_venta/ZC_PRC_VENTA
RENTABILIDAD_AUTH_USER=
RENTABILIDAD_AUTH_PASS=
RENTABILIDAD_SAP_CLIENT=160

# --- Modo demo ---
# En true: si una API real falla o no está configurada, el dashboard sirve datos de muestra
# en lugar de romper la pantalla. Recomendado dejarlo en true hasta tener las 3 APIs 100% activas.
DEMO_MODE_FALLBACK=true

# --- Cache en memoria (no hay base de datos) ---
CACHE_TTL_SECONDS=120
